{
  "name": "@local/pdf-math-reader",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "PDF reader, bilingual academic translation, reading notes and AI reading plugin for DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "translation",
    "pdfjs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/**",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-host.mjs && node scripts/test-artifact.mjs && node scripts/test-text.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.5"
  }
}
