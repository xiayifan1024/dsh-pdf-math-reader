{
  "name": "dsh-pdf-math-reader",
  "version": "1.5.0",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "description": "PDF reader, bilingual academic translation, reading notes and AI reading plugin for DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "translation",
    "pdfjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiayifan1024/dsh-pdf-math-reader.git"
  },
  "homepage": "https://github.com/xiayifan1024/dsh-pdf-math-reader",
  "bugs": {
    "url": "https://github.com/xiayifan1024/dsh-pdf-math-reader/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**",
    "assets/**",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test && node scripts/smoke-host.mjs && node scripts/smoke-artifact.mjs && node scripts/smoke-text.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.5"
  },
  "engines": {
    "node": ">=18"
  }
}
